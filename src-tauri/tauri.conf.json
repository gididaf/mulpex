{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mulpex",
  "version": "0.7.3",
  "identifier": "com.mulpex.app",
  "build": {
    "beforeDevCommand": "cargo build -p mulpex-helper && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/bundle-helper.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mulpex",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/gididaf/mulpex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5N0YyMzQzREQ0OTk2NjkKUldScGxrbmRReU4vR2Nlb2dNNy9INzhPOFd6T1pGMlVkMEtTdkQxZnJTVFZialkyWjMzTkRjWkoK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/mulpex-helper"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "356EABC7A6DFF95034AFB51B24FA1162FB600E1B"
    }
  }
}
